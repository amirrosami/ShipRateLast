@model DashboardViewModel
@using System.Globalization
@using ShipRate.WebAppCustomers.ViewModels
@{
    var isFa = CultureInfo.CurrentUICulture.Name.StartsWith("fa");
    ViewData["Title"] = isFa ? "داشبورد مشتری" : "Customer Dashboard";
}

<div class="shipping-overview">
    <!-- Welcome -->
    <section class="overview-banner">
        <div class="hero-content">
            <div class="hero-badge">
                <i aria-hidden="true" class="fa-solid fa-ship"></i>
                <span>@(isFa ? "داشبورد مشتریان" : "Customer Portal")</span>
            </div>

            <h2>@(isFa ? "خوش آمدید به درگاه مشتریان" : "Welcome to the Customer Portal")</h2>
            <p>
                @(isFa
                                ? "از این بخش می‌توانید سفارش‌ها، محموله‌ها، اسناد، پرداخت‌ها و درخواست‌های پشتیبانی خود را مدیریت کنید."
                                : "Manage your orders, shipments, documents, payments and support requests from here.")
            </p>
        </div>

        <div class="hero-actions">
            <a asp-controller="RateRequests" asp-action="Index" class="btn btn-primary">
                <i aria-hidden="true" class="fa-solid fa-plus"></i>
                <span>@(isFa ? "ثبت سفارش جدید" : "New Order")</span>
            </a>
            <a asp-controller="Tracking" asp-action="Index" class="btn btn-outline">
                <i aria-hidden="true" class="fa-solid fa-location-dot"></i>
                <span>@(isFa ? "رهگیری محموله" : "Track Shipment")</span>
            </a>
        </div>
    </section>

    <!-- Stats -->
    <section class="stats-grid">
        <div class="overview-stat">
            <span class="stat-icon"><i aria-hidden="true" class="fa-solid fa-box"></i></span>
            <div>
                <h3>12</h3>
                <p>@(isFa ? "سفارشات فعال" : "Active Orders")</p>
            </div>
        </div>

        <div class="overview-stat">
            <span class="stat-icon"><i aria-hidden="true" class="fa-solid fa-truck-fast"></i></span>
            <div>
                <h3>7</h3>
                <p>@(isFa ? "محموله‌های در حال حمل" : "In Transit")</p>
            </div>
        </div>

        <div class="overview-stat">
            <span class="stat-icon"><i aria-hidden="true" class="fa-solid fa-receipt"></i></span>
            <div>
                <h3>4</h3>
                <p>@(isFa ? "فاکتورهای پرداخت‌نشده" : "Unpaid Invoices")</p>
            </div>
        </div>

        <div class="overview-stat">
            <span class="stat-icon"><i aria-hidden="true" class="fa-solid fa-comments"></i></span>
            <div>
                <h3>3</h3>
                <p>@(isFa ? "تیکت‌های باز" : "Open Tickets")</p>
            </div>
        </div>
    </section>

    <section class="overview-grid">
        <!-- Recent Orders -->
        <div class="overview-panel">
            <div class="overview-heading">
                <h3>@(isFa ? "سفارش‌های اخیر" : "Recent Orders")</h3>
                <a asp-controller="RateRequests" asp-action="Index">@(isFa ? "مشاهده همه" : "View All")</a>
            </div>

            <div class="table-responsive">
                <table class="overview-table">
                    <thead>
                        <tr>
                            <th scope="col">@(isFa ? "کد سفارش" : "Order No")</th>
                            <th scope="col">@(isFa ? "مبدأ" : "Origin")</th>
                            <th scope="col">@(isFa ? "مقصد" : "Destination")</th>
                            <th scope="col">@(isFa ? "وضعیت" : "Status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RateRequests.Count == 0)
                        {
                            <tr><td colspan="4" class="overview-empty">@(isFa ? "سفارش اخیری برای نمایش وجود ندارد." : "No recent orders to display.")</td></tr>
                        }
                        @foreach (var item in Model.RateRequests)
                        {
                            <tr>
                                <td><bdi>@item.RequestNo</bdi></td>
                                <td>@item.OriginName</td>
                                <td>@item.DestinationName</td>
                                <td>
                                    <span class="status-pill">@item.StatusName</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Invoices -->
        <section class="overview-panel">
            <div class="overview-heading">
                <h3>@(isFa ? "فاکتورهای اخیر" : "Recent Invoices")</h3>
                <a asp-controller="Invoices" asp-action="Index">@(isFa ? "مشاهده همه" : "View All")</a>
            </div>

            <div class="table-responsive">
                <table class="overview-table">
                    <thead>
                        <tr>
                            <th scope="col">@(isFa ? "شرکت" : "Company")</th>
                            <th scope="col">@(isFa ? "شماره فاکتور" : "Invoice No")</th>
                            <th scope="col">@(isFa ? "مبلغ" : "Amount")</th>
                            <th scope="col">@(isFa ? "وضعیت" : "Status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Invoices.Count == 0)
                        {
                            <tr><td colspan="4" class="overview-empty">@(isFa ? "فاکتور اخیری برای نمایش وجود ندارد." : "No recent invoices to display.")</td></tr>
                        }
                        @foreach (var item in Model.Invoices)
                        {
                            <tr>
                                <td>@item.Company.Person.PersonName</td>
                                <td><bdi>@item.InvoiceNo</bdi></td>
                                <td>@item.TotalAmount</td>
                                <td>
                                    <span class="status-pill">@item.InvoiceStatus.InvoiceStatusName</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Notifications -->
        <div class="overview-panel overview-feed">
            <div class="overview-heading">
                <h3>@(isFa ? "اعلان‌ها" : "Notifications")</h3>
                <a asp-controller="Notifications" asp-action="Index">@(isFa ? "همه" : "All")</a>
            </div>

            <div class="notification-list">

                @if (Model.Notifications.Count == 0)
                {
                    <p class="overview-empty">@(isFa ? "اعلانی برای نمایش وجود ندارد." : "No notifications to display.")</p>
                }
                @foreach (var item in Model.Notifications)
                {
                    <div class="notification-item">
                        <span class="dot"></span>
                        <div>
                            <strong>@item.Subject</strong>
                            <small><bdi dir="ltr">@item.DateQueued.ToString("yyyy-MM-dd HH:mm:ss")</bdi></small>
                            <p>@item.Body</p>
                        </div>
                    </div>
                }

            </div>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-overview.css" asp-append-version="true" />
}
