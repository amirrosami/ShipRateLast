@using Microsoft.Extensions.Localization
@using System.Globalization
@using ShipRate.Application.ViewModels
@using ShipRate.WebAppCustomers
@inject IStringLocalizer<SharedResource> Localizer
@model List<CommitmentFileListItemVm>

@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var direction = isRtl ? "rtl" : "ltr";
    var textAlign = isRtl ? "text-end" : "text-start";
    ViewData["Title"] = Localizer["CommitmentLetters"];
}

<div class="requests-page finance-page commitments-page container-fluid py-3" dir="@direction">
    <section class="commitments-hero mb-4">
        <div class="commitments-hero-icon" aria-hidden="true">
            <i class="bi bi-file-earmark-arrow-down"></i>
        </div>
        <div class="commitments-hero-content">
            <h2 class="commitments-page-title mb-1">@Localizer["CommitmentLetters"]</h2>
            <div class="commitments-hero-caption">
                <span class="commitments-count">@((Model?.Count) ?? 0)</span>
            </div>
        </div>
    </section>

    @if (Model != null && Model.Any())
    {
        <div class="row g-3 commitments-grid">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card commitment-card h-100">
                        <div class="card-body @textAlign">
                            <div class="commitment-file-icon" aria-hidden="true">
                                <i class="bi bi-file-earmark-word"></i>
                            </div>

                            <h5 class="commitment-file-title">
                                @(isRtl ? item.FileTitle : item.LatinName)
                            </h5>

                            <p class="commitment-file-description mb-3">
                                @(isRtl ? item.Description : item.LatinDscp)
                            </p>

                            <div class="commitment-file-date">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                <span class="commitment-date-label">@Localizer["UploadDate"]:</span>
                                <span>
                                    @(item.UploadDate.HasValue
                                        ? item.UploadDate.Value.ToString("yyyy/MM/dd")
                                        : "-")
                                </span>
                            </div>
                        </div>

                        <div class="card-footer commitment-card-footer">
                            <a asp-action="DownloadCommitmentFile"
                               asp-route-fileName="@item.FileName"
                               class="btn btn-primary w-100 commitment-download-btn"
                               title="@Localizer["Download"]">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                <span>@Localizer["Download"]</span>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info commitments-empty-state mb-0" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>@Localizer["NoCommitmentLettersFound"]</span>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-requests.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commitments-page.css" asp-append-version="true" />
}
